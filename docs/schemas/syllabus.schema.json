{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "results": {
      "minItems": 3,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "prerequisites": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "modules": {
      "minItems": 2,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "skills": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{3,60}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "bloom": {
                  "type": "string",
                  "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
                }
              },
              "required": ["id", "name", "bloom"],
              "additionalProperties": false
            }
          },
          "lessons": {
            "minItems": 3,
            "maxItems": 9,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["video", "text", "exercises"]
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "goal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "skills": {
                  "minItems": 1,
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["type", "title", "goal", "skills"],
              "additionalProperties": false
            }
          },
          "project": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "rubric": {
                "minItems": 2,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            "required": ["title", "prompt", "rubric"],
            "additionalProperties": false
          }
        },
        "required": ["title", "goal", "skills", "lessons", "project"],
        "additionalProperties": false
      }
    },
    "bibliography": {
      "minItems": 3,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "author": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "institution": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": ["course", "book", "article", "documentation", "site", "video"]
          },
          "url": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "maxLength": 800,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "license": {
            "default": "unknown",
            "type": "string",
            "enum": ["cc0", "cc-by", "cc-by-sa", "public-domain", "cc-by-nc", "cc-by-nc-sa", "proprietary", "unknown"]
          },
          "reason": {
            "default": "",
            "type": "string",
            "maxLength": 400
          }
        },
        "required": ["title", "type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "summary", "results", "prerequisites", "modules", "bibliography"],
  "additionalProperties": false
}
