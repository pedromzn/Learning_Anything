                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                }
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1400
              }
            },
            "required": ["type", "lang", "code", "narration"],
            "additionalProperties": false
          },
          {
            "type": "object",
