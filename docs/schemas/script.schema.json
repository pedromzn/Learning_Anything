                "default": "",
                "type": "string",
                "maxLength": 200
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1400
              }
            },
            "required": ["type", "lines", "narration"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "code"
              },
              "lang": {
                "type": "string",
                "enum": ["cpp", "c", "python", "javascript", "pseudocode"]
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1600
              },
              "highlights": {
                "default": [],
                "maxItems": 8,
                "type": "array",
