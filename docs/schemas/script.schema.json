                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]{2,40}$"
                      },
                      "skill": {
                        "type": "string",
                        "maxLength": 60
                      },
                      "bloom": {
                        "type": "string",
                        "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
                      },
                      "difficulty": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2500
                      },
                      "hints": {
                        "default": [],
                        "maxItems": 3,
                        "type": "array",
