                "maxLength": 120
              },
              "subtitle": {
                "default": "",
                "type": "string",
                "maxLength": 160
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1400
              }
            },
            "required": ["type", "title", "narration"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "bullets"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "bullets": {
                "minItems": 2,
                "maxItems": 5,
