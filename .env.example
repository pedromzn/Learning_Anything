# Everything is optional. Without a .env, the app starts at http://localhost:3040.
PORT=3040
HOST=127.0.0.1
# auto | kokoro | silence  (auto: Kokoro if installed with `npm run voice:install`, otherwise silence)
VOICE_ENGINE=auto
# the lessons' voice (a Kokoro voice). Leave empty to use each course's language default:
# af_heart in English, pf_dora in Portuguese (pt-BR also has pm_alex and pm_santa)
VOICE=
# speaking speed, from 0.5 to 2 (1 = normal)
VOICE_SPEED=1
# video resolution: 720p (default, renders in half the time) | 1080p
VIDEO_QUALITY=720p
# Feynman block (teach Ana): the Ollama model (default: the first installed among qwen3:8b, qwen3:4b,
# llama3.1:8b, gemma3:4b), the Ollama address and the Whisper size (base | small | medium; default small)
FEYNMAN_MODEL=
OLLAMA_HOST=127.0.0.1:11434
FEYNMAN_WHISPER=small
# Community tab: off keeps it offline (it lists community/courses/ in this folder); COMMUNITY_REPO points a fork's
# app at its own catalog (owner/name)
COMMUNITY=on
COMMUNITY_REPO=
